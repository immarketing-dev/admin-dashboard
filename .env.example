# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DB_HOST=localhost
DB_NAME=admin_dashboard
DB_USER=admin_dashboard
DB_PASS=

# ---------------------------------------------------------------
# Branding — can also be changed later under Settings
# ---------------------------------------------------------------
APP_NAME="Admin Panel"
COMPANY_NAME="Your Company"
COMPANY_SHORT="Your Company"
BASE_URL=https://admin.example.com
MAIN_WEBSITE=https://example.com
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com

COLOR_PRIMARY=#149ddd
COLOR_SIDEBAR=#040b14

# ---------------------------------------------------------------
# Outgoing mail (portal links, quotes, milestone notifications)
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# ---------------------------------------------------------------
# Cross-domain single sign-on. Leave disabled unless you run the
# panel on a separate subdomain from your main site and understand
# the trust relationship it creates.
# ---------------------------------------------------------------
SSO_ENABLED=false

# ---------------------------------------------------------------
# Public demo instance. Grants a session without a password and
# blocks every write. Only ever enable this on a throwaway database
# seeded with tools/seed_demo.php - never on a real installation.
# See docs/DEMO.md before switching this on.
# ---------------------------------------------------------------
DEMO_MODE=false

# Access code shown on the demo portal's PIN card and written to the
# seeded contacts by tools/seed_demo.php. Ignored unless DEMO_MODE=true.
DEMO_PORTAL_PIN=1234
