# Entwicklungswerkzeuge - zur Laufzeit nie aufgerufen, deshalb hier komplett
# gesperrt. Zweite Absicherung neben der Rewrite-Regel in der Wurzel-.htaccess,
# damit der Schutz auch ohne mod_rewrite greift.
#
# Besonders relevant fuer tools/leakscan-local.txt: diese Datei listet
# absichtlich die Zeichenketten auf, die niemals veroeffentlicht werden duerfen.
# Sie ist gitignored - aber wer das Projekt per FTP hochlaedt, traegt sie
# womoeglich mit ins Webroot.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
