# Kundenunterlagen - kein direkter Zugriff ueber den Webserver.
#
# Diese Dateien lagen frueher offen im Netz: wer den Pfad kannte, bekam
# sie ohne Anmeldung. Bei Rechnungen war der Pfad nicht einmal zu raten,
# sie hiessen "Rechnung_RE-2026-001.pdf" und liessen sich durchzaehlen.
#
# Der einzige Weg hinein ist jetzt file.php, das vorher prueft, wer
# fragt und was ihm zusteht (includes/file_access.php). PHP liest die
# Datei dabei selbst - diese Sperre gilt nur fuer den Webserver und
# steht readfile() nicht im Weg.
#
# ACHTUNG: Diese Datei nicht entfernen. tools/check.sh haelt nach, dass
# sie in jedem Verzeichnis mit Kundendaten liegt und wirklich sperrt.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes
