# PHP-Ausführung in uploads/ vollständig unterbinden.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
